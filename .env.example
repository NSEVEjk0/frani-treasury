# ─────────────────────────────────────────────────────────────
#  frani-treasury — example configuration
#  Copy to .env and edit. EVERY value has a safe, conservative
#  default, so an empty/absent .env runs a valid, timid testnet2
#  treasury out of the box. (.env is gitignored — never commit it.)
#  Made by CRYPTFRANI · Owner: Itachi
# ─────────────────────────────────────────────────────────────

# ── Core identity & network ──────────────────────────────────
# The nametag the treasury claims (without the leading '@').
AGENT_NAME=frani-treasury
# Unicity network to run against.
UNICITY_NETWORK=testnet2

# ── Owner admin (protected commands over DM) ──────────────────
# Set this to YOUR controlling identity's chain pubkey to unlock the
# owner-only DM commands (pause/resume/params/topup/forgive/blacklist/
# unfreeze). Leave EMPTY (default) to disable the admin surface entirely.
# OWNER_PUBKEY=

# ─────────────────────────────────────────────────────────────
#  Optional advanced settings (defaults shown) — safe to omit
# ─────────────────────────────────────────────────────────────

# ── Wallet storage / security ─────────────────────────────────
# WALLET_DIR=./wallet-data
# WALLET_FILE=wallet.json
# Encrypt the mnemonic at rest (recommended on a shared host). Empty = plaintext.
# WALLET_PASSWORD=

# ── Network endpoints (rarely changed) ────────────────────────
# COIN_SYMBOL=UCT
# WALLET_API_URL=https://wallet-api.unicity.network
# Public testnet2 oracle/aggregator key (NOT a secret; safe default baked in).
# ORACLE_API_KEY=

# ── Tiered treasury policy — the rules the agent funds by ─────
# TIER 1 boundary: a disbursement <= this is a pure SEED GRANT (no repayment,
# no debt tracked). Above it, funding is booked as a repayable micro-LOAN.
# GRANT_MAX_UCT=1
# Repayment term for Tier-2 loans, in days. Miss it and the account freezes
# until the debt is settled.
# LOAN_TERM_DAYS=7
# Absolute hard ceiling on ANY single disbursement, regardless of tier.
# MAX_SINGLE_UCT=10
# Rolling 24-hour outflow budget across ALL requesters combined.
# DAILY_BUDGET_UCT=25
# Untouchable reserve — spendable balance is never allowed below this.
# MIN_BALANCE_FLOOR_UCT=25
# Max funding requests considered per requester per rolling 24h.
# MAX_REQUESTS_PER_24H=5

# ── Reputation ladder (Newbie → Trusted → Partner) ────────────
# On-time repayments promote a requester, raising their loan ceiling and
# shortening their cooldown. Grants are available to every tier.
# TIER_NEWBIE_MAX_UCT=2
# TIER_NEWBIE_COOLDOWN_MIN=60
# TIER_TRUSTED_MAX_UCT=5
# TIER_TRUSTED_COOLDOWN_MIN=30
# TIER_TRUSTED_PROMOTE_AT=2
# TIER_PARTNER_MAX_UCT=10
# TIER_PARTNER_COOLDOWN_MIN=15
# TIER_PARTNER_PROMOTE_AT=5
# Early-repayment perk: repaying before the due date temporarily raises the
# personal daily request limit.
# EARLY_BONUS_HOURS=24
# EARLY_BONUS_EXTRA_REQUESTS=2
# Extra cool-off applied after an account goes overdue (on top of "until settled").
# OVERDUE_FREEZE_HOURS=48

# ── Economic safety rails ─────────────────────────────────────
# Global observe-only kill-switch: log intended actions but touch nothing.
# DRY_RUN=false
# Master outflow switch. false = evaluate & reply to requests but disburse
# nothing (advice-only / instant freeze without a redeploy). Owner `pause` flips this live.
# DISBURSE_ENABLED=true
# One-time capped self-mint to seed the corpus on first run (no faucet on testnet2).
# SELF_MINT_ENABLED=true
# SELF_MINT_AMOUNT=250
# Refund the surplus when a borrower overpays a repayment (the other permitted outflow).
# AUTO_REFUND_OVERPAYMENT=true
# Politeness / anti-spam (relay protection; NOT a money control).
# MAX_DMS_PER_HOUR=40
# MAX_ACTIONS_PER_HOUR=80
# Global cap on the NUMBER of disbursements per hour (rate, not amount).
# MAX_DISBURSEMENTS_PER_HOUR=20

# ── Housekeeping cadences ─────────────────────────────────────
# How often to sweep loans for due-soon reminders / overdue transitions (ms).
# SWEEP_MS=900000
# Cadence for the incoming-transfer / DM safety-net receive() poll (ms).
# RECEIVE_POLL_MS=45000

# ── Public advert / broadcast ─────────────────────────────────
# Keep a standing `service` intent advertising the treasury on the market board.
# SERVICE_INTENT_ENABLED=true
# INTENT_EXPIRES_DAYS=7
# SERVICE_DESCRIPTION=frani-treasury: an autonomous, rules-based UCT treasury ...
# Emit a public solvency heartbeat to the broadcast channel each sweep (off by default).
# BROADCAST_ENABLED=false
# BROADCAST_TAGS=treasury,grants,unicity

# ── Misc ──────────────────────────────────────────────────────
# LOG_LEVEL=info
